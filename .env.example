# ===== MediaVault Environment Variables =====
# Copy this file to .env and fill in your API keys

# Discogs API Token (required for vinyl search/scan)
# Get yours: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=your_discogs_token_here

# Notion API Key (required for Notion sync)
# Create: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_api_key_here

# Notion Database IDs (required for Notion sync)
# Find: Open your Notion database → Copy link → Extract the ID from the URL
NOTION_VINYLS_DB_ID=your_vinyls_database_id_here
NOTION_MOVIES_DB_ID=your_movies_database_id_here

# OMDB API Key (required for movie/TV search)
# Get yours: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here
